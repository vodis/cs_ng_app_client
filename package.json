{
  "name": "cs-ng-app-client",
  "version": "0.0.3",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-dev": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build --configuration development  --aot && gulp compress",
    "build-prod": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build --configuration production  --aot && gulp compress",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint --ext .ts --ext .html ./ --fix",
    "lint-fix": "ng lint --fix",
    "format": "prettier --write ./",
    "stylelint-check": "stylelint src/**/*scss",
    "stylelint-fix": "stylelint src/**/*scss --fix",
    "audit": "pnpm audit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/module-federation": "^19.0.0",
    "@angular-architects/module-federation-runtime": "^19.0.0",
    "@angular-architects/module-federation-tools": "^19.0.0",
    "@angular/animations": "^19.2.0",
    "@angular/cdk": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@babel/runtime": "^7.28.6",
    "@hakimio/ngx-google-analytics": "^15.0.0",
    "liveline": "^0.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular-eslint/builder": "^19.0.0",
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/schematics": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@playwright/test": "^1.61.0",
    "@types/jasmine": "^5.1.4",
    "@types/jasminewd2": "^2.0.13",
    "@types/node": "^20.11.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "gulp": "^4.0.2",
    "gulp-gzip": "^1.4.2",
    "husky": "^9.0.11",
    "jasmine-core": "^5.1.2",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lint-staged": "^15.2.2",
    "ng-packagr": "^19.2.0",
    "ngx-build-plus": "^19.0.0",
    "prettier": "^3.2.5",
    "prettier-eslint": "^16.3.0",
    "serve": "^14.2.1",
    "stylelint": "^16.2.1",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-recommended-scss": "^14.0.0",
    "stylelint-config-standard": "^36.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3",
    "word-wrap": "^1.2.5"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "pnpm run lint",
      "pnpm run format"
    ],
    "*.scss": [
      "pnpm run stylelint-fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "pnpm": {
    "overrides": {
      "braces@<3.0.3": ">=3.0.3",
      "micromatch@<4.0.8": ">=4.0.8",
      "koa@>=2.0.0 <2.16.2": ">=2.16.2",
      "koa@<2.16.1": ">=2.16.1",
      "tar@<=7.5.3": ">=7.5.4",
      "tar@<7.5.7": ">=7.5.7",
      "tar@<=7.5.2": ">=7.5.3",
      "tar@<7.5.8": ">=7.5.8",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "koa@<2.16.4": ">=2.16.4",
      "serialize-javascript@<=7.0.2": ">=7.0.3",
      "tar@<=7.5.9": ">=7.5.10",
      "tar@<=7.5.10": ">=7.5.11"
    }
  }
}
