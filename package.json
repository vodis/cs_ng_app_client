{
  "name": "cs-ng-app-client",
  "version": "0.0.3",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=local",
    "build": "ng build",
    "build-dev": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build --configuration development  --aot && gulp compress",
    "build-prod": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build --configuration production  --aot && gulp compress",
    "build-staging": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build --configuration staging --aot && gulp compress",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint --ext .ts --ext .html ./ --fix",
    "lint-fix": "ng lint --fix",
    "format": "prettier --write ./",
    "stylelint-check": "stylelint src/**/*scss",
    "stylelint-fix": "stylelint src/**/*scss --fix",
    "audit": "pnpm audit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/module-federation": "^20.0.0",
    "@angular-architects/module-federation-runtime": "^20.0.0",
    "@angular-architects/module-federation-tools": "^20.0.0",
    "@angular/animations": "^20.3.31",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.31",
    "@angular/compiler": "^20.3.31",
    "@angular/core": "^20.3.31",
    "@angular/forms": "^20.3.31",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.31",
    "@angular/platform-browser-dynamic": "^20.3.31",
    "@angular/router": "^20.3.31",
    "@babel/runtime": "^7.28.6",
    "@hakimio/ngx-google-analytics": "^15.0.0",
    "@module-federation/runtime-core": "0.6.21",
    "@vodis/cs-foundation": "0.2.3",
    "@vodis/cs-intents": "0.1.0",
    "liveline": "^0.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.37",
    "@angular-eslint/builder": "^19.8.1",
    "@angular-eslint/eslint-plugin": "^19.8.1",
    "@angular-eslint/eslint-plugin-template": "^19.8.1",
    "@angular-eslint/schematics": "^19.8.1",
    "@angular-eslint/template-parser": "^19.8.1",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.31",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@playwright/test": "^1.61.0",
    "@types/jasmine": "^5.1.4",
    "@types/jasminewd2": "^2.0.13",
    "@types/node": "^20.11.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "gulp": "^4.0.2",
    "gulp-gzip": "^1.4.2",
    "husky": "^9.0.11",
    "jasmine-core": "^5.1.2",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lint-staged": "^15.2.2",
    "ng-packagr": "^20.3.2",
    "ngx-build-plus": "^20.0.0",
    "prettier": "^3.2.5",
    "prettier-eslint": "^16.3.0",
    "serve": "^14.2.1",
    "stylelint": "^16.2.1",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-recommended-scss": "^14.0.0",
    "stylelint-config-standard": "^36.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "word-wrap": "^1.2.5"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "pnpm run lint",
      "pnpm run format"
    ],
    "*.scss": [
      "pnpm run stylelint-fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.7",
