      "braces@<3.0.3": "3.0.3",
      "browserslist@<=4.28.6": "4.28.7",
      "colord@<2.9.4": "2.9.4",
      "engine.io@>=4.1.0 <6.6.7": "6.6.7",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "flatted@<=3.4.1": "3.4.2",
      "follow-redirects@<=1.15.11": "1.16.0",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "http-proxy-middleware@>=0.16.0 <2.0.10": "2.0.10",
      "http-proxy-middleware@>=3.0.4 <3.0.7": "3.0.7",
      "immutable@>=5.0.0-beta.1 <5.1.8": "5.1.8",
      "ip-address@<=10.3.0": "10.3.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "koa@<2.16.4": "2.16.4",
      "lodash@<=4.17.23": "4.18.0",
      "micromatch@<4.0.8": "4.0.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "nanoid@<3.3.18": "3.3.18",
      "path-to-regexp@<0.1.13": "0.1.13",
      "picomatch@<2.3.2": "2.3.2",
